    <Setter variable="val9" function="0" priority="0" activator="Time &lt; 0.01" />
    <Setter variable="val9" function="valt" priority="0" activator="enter &amp; sel = 9" />
    <Setter variable="valt" function="(Cycvs*2-1)*-1*(d1*1000000+d2*100000+d3*10000+d4*1000+d5*100+d6*10+d7)" priority="0" />
    <Setter variable="check1" function="0" priority="0" activator="clamp01(rate(sel = -1))" />
    <Setter variable="check1" function="1" priority="0" activator="clamp01(rate(enter=0)) &amp; sel != -1" />
    <Setter variable="check2" function="0" priority="0" activator="clamp01(rate(sel != -1))" />
    <Setter variable="check2" function="1" priority="0" activator="clamp01(rate(enter=0)) &amp; sel = -1 | exit | Time &lt; 0.01" />
    <Setter variable="sel" function="-1" priority="0" activator="enter &amp; check1 | exit | Time &lt; 0.01" />
    <Setter variable="gearDelay" function="0.2" priority="0" />
    <Setter variable="elevatorInput" function="clamp(AutopilotAP ? (PitchAP ? elevatorControl1 : elevatorControl2) : Pitch - PitchRate/160, -1, 1)" priority="0" />
    <Setter variable="elevatorControl1" function="-(0.06*delta1 + 0.0005*(sum(delta1) - reset1))" priority="0" />
    <Setter variable="reset1" function="sum1" priority="0" activator="clamp01(rate(AutopilotAP)) | clamp01(rate(PitchAP = 1))" />
    <Setter variable="delta1" function="target1 - (PitchAngle + AngleOfAttack)" priority="0" />
    <Setter variable="target1" function="atan(h*0.001)*2/3" priority="0" />
    <Setter variable="h" function="val2 - (Altitude*3.28084)" priority="0" />
    <Setter variable="elevatorControl2" function="-(0.06*delta3 + 0.0005*(sum(delta3) - reset3))" priority="0" />
    <Setter variable="delta3" function="-(PitchAngle + AngleOfAttack)" priority="0" />
    <Setter variable="aileronInput" function="AutopilotAP ? (RollAP ? aileronControl1 : aileronControl2) : Roll" priority="0" />
    <Setter variable="aileronControl1" function="-(0.01*delta2)" priority="0" />
    <Setter variable="delta2" function="target2 - RollAngle" priority="0" />
    <Setter variable="target2" function="0.5*atan(0.5*(deltaangle((val0-Latitude &lt; 0 ? 180 : 0) + atan((val1-Longitude)/(val0-Latitude)), -deltaangle(Heading, - AngleOfSlip))))" priority="0" />
    <Setter variable="aileronControl2" function="-(0.025*delta4)" priority="0" />
    <Setter variable="delta4" function="-RollAngle" priority="0" />
    <Setter variable="reset3" function="sum3" priority="0" activator="clamp01(rate(AutopilotAP)) | clamp01(rate(RollAP = 1))" />
    <Setter variable="sum1" function="sum(delta1)" priority="0" />
    <Setter variable="sum3" function="sum(delta3)" priority="0" />
    <Setter variable="RollAP" function="0" priority="0" activator="sqrt(pow(Latitude-val0,2) + pow(Longitude-val1,2)) &lt; 100" />
    <Setter variable="waypointLatitude" function="val0" priority="0" />
    <Setter variable="waypointLongitude" function="val1" priority="0" />
    <Setter variable="targetTracker" function="1" priority="0" activator="Time &lt; 0.05" />
    <Setter variable="waypointPosition" function="1" priority="0" activator="Time &lt; 0.05" />
