    <Setter variable="vroty" function="sin(H)*cos(P)" priority="0" />
    <Setter variable="vrotz" function="sin(P)" priority="0" />
    <Setter variable="e1x" function="-cos(H)*sin(P)*cos(R)+sin(H)*sin(R)" priority="0" />
