    <Setter variable="CycSel" function="(3 + CycSel + (sel = -1 ? -clamp01(rate(sUp)) + clamp01(rate(sDown)) : 0)) % 3" priority="0" />
    <Setter variable="enter" function="0" priority="-1" />
    <Setter variable="exit" function="0" priority="-1" />
    <Setter variable="sel" function="CycSel" priority="0" activator="enter &amp; check2" />
    <Setter variable="Cycblink" function="-sin((Time-t1)*300)" priority="0" />
    <Setter variable="t1" function="Time" priority="0" activator="clamp01(rate(sel != -1))" />
    <Setter variable="val0" function="0" priority="0" activator="Time &lt; 0.01" />
