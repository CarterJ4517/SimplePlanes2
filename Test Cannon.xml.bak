<?xml version="1.0" encoding="utf-8"?>
<Aircraft name="Test Cannon" url="BxvFg9" theme="Custom" aerodynamicsModel="Legacy" paintOrigin="0,2.5,0" size="3.88864,2.25598,6.922339" boundsOffset="3.722213E-05,-1.006898,-1.239224" boundsMin="-1.944328,1.845853,-3.37167" xmlVersion="22" legacyJointIdentification="false" clientVersion="0.5.10.2">
  <Variables>
    <Setter variable="H" function="Heading" priority="0" />
    <Setter variable="P" function="PitchAngle" priority="0" />
    <Setter variable="R" function="RollAngle" priority="0" />
    <Setter variable="Hread" function="round(((360+Heading)%360)*10)/10 = 360 ? 0 : round(((360+Heading)%360)*10)/10" priority="0" />
    <Setter variable="Pread" function="round(PitchAngle*10)/10" priority="0" />
    <Setter variable="Rread" function="round(((360+RollAngle)%360)*10)/10 = 360 ? 0 : round(((360+RollAngle)%360)*10)/10" priority="0" />
    <Setter variable="Htarget" function="theta1" priority="0" />
    <Setter variable="Ptarget" function="phi1" priority="0" />
    <Setter variable="vrotx" function="cos(H)*cos(P)" priority="0" />
    <Setter variable="vroty" function="sin(H)*cos(P)" priority="0" />
    <Setter variable="vrotz" function="sin(P)" priority="0" />
    <Setter variable="vfinalx" function="cos(Htarget)*cos(Ptarget)" priority="0" />
    <Setter variable="vfinaly" function="sin(Htarget)*cos(Ptarget)" priority="0" />
    <Setter variable="vfinalz" function="sin(Ptarget)" priority="0" />
    <Setter variable="e1x" function="-cos(H)*sin(P)*cos(R)+sin(H)*sin(R)" priority="0" />
    <Setter variable="e1y" function="-sin(H)*sin(P)*cos(R)-cos(H)*sin(R)" priority="0" />
    <Setter variable="e1z" function="cos(P)*cos(R)" priority="0" />
    <Setter variable="e2tempx" function="e1y*vfinalz - e1z*vfinaly " priority="0" />
    <Setter variable="e2tempy" function="e1z*vfinalx - e1x*vfinalz " priority="0" />
    <Setter variable="e2tempz" function="e1x*vfinaly - e1y*vfinalx " priority="0" />
    <Setter variable="e2mag" function="pow(pow(e2tempx,2)+pow(e2tempy,2)+pow(e2tempz,2),0.5) " priority="0" />
    <Setter variable="e2x" function="e2tempx/e2mag" priority="0" />
    <Setter variable="e2y" function="e2tempy/e2mag" priority="0" />
    <Setter variable="e2z" function="e2tempz/e2mag" priority="0" />
    <Setter variable="vintertempx" function="e2y*e1z-e2z*e1y" priority="0" />
    <Setter variable="vintertempy" function="e2z*e1x-e2x*e1z" priority="0" />
    <Setter variable="vintertempz" function="e2x*e1y-e2y*e1x" priority="0" />
    <Setter variable="vintermag" function="pow(pow(vintertempx,2)+pow(vintertempy,2)+pow(vintertempz,2), 0.5)" priority="0" />
    <Setter variable="vinterx" function="vintertempx/vintermag" priority="0" />
    <Setter variable="vintery" function="vintertempy/vintermag" priority="0" />
    <Setter variable="vinterz" function="vintertempz/vintermag" priority="0" />
    <Setter variable="thetatemp" function="acos(vrotx*vinterx + vroty*vintery + vrotz*vinterz)" priority="0" />
    <Setter variable="phitemp" function="acos(vinterx*vfinalx + vintery*vfinaly + vinterz*vfinalz)" priority="0" />
    <Setter variable="check1" function="e1x*(vroty*vinterz-vrotz*vintery) + e1y*(vrotz*vinterx-vrotx*vinterz) + e1z*(vrotx*vintery-vroty*vinterx)" priority="0" />
    <Setter variable="check2" function="e2x*(vintery*vfinalz-vinterz*vfinaly) + e2y*(vinterz*vfinalx-vinterx*vfinalz) + e2z*(vinterx*vfinaly-vintery*vfinalx)" priority="0" />
    <Setter variable="theta" function="thetatemp*(check1 &lt; 0 ? -1 : 1)" priority="0" />
    <Setter variable="phi" function="phitemp*(check2 &lt; 0 ? -1 : 1)" priority="0" />
    <Setter variable="i1" function="theta/180" priority="0" />
    <Setter variable="j1" function="phi/90" priority="0" />
    <Setter variable="counter" function="counter + clamp01(abs(rate(ammo(&quot;Cannon&quot;))))" priority="0" />
    <Setter variable="cycle" function="(smooth(counter,2)+0.999)%1" priority="0" />
    <Setter variable="i1" function="sum(0.6*pow(Roll,2)*sign(Roll))" priority="1" activator="Activate1" />
    <Setter variable="j1" function="sum(((Pitch &gt; 0 &amp; pitchAngle &gt; -17.5) | (Pitch &lt; 0 &amp; pitchAngle &lt; 85.49)) ? 0.6*pow(Pitch,2)*sign(Pitch) : 0)" priority="1" activator="Activate1" />
    <Setter variable="vxtr" function="rate(TargetDistance*cos(TargetElevation)*sin(TargetHeading))" priority="0" />
    <Setter variable="vytr" function="rate(TargetDistance*cos(TargetElevation)*cos(TargetHeading))" priority="0" />
    <Setter variable="vztr" function="rate(TargetDistance*sin(TargetElevation))" priority="0" />
    <Setter variable="vdtr" function="rate(TargetDistance*cos(TargetElevation))" priority="0" />
    <Setter variable="g" function="-9.81" priority="0" />
    <Setter variable="dt" function="TargetDistance*cos(TargetElevation) " priority="0" />
    <Setter variable="zt" function="TargetDistance*sin(TargetElevation) " priority="0" />
    <Setter variable="vc" function="2000" priority="0" />
    <Setter variable="a1" function="(g*pow(dt,2))/(2*pow(vc,2))" priority="0" />
    <Setter variable="b1" function="dt" priority="0" />
    <Setter variable="c1" function="a1-zt" priority="0" />
    <Setter variable="u" function="(-b1+sqrt(pow(b1,2) - 4*a1*c1))/(2*a1)" priority="0" />
    <Setter variable="pe" function="atan(u)" priority="0" />
    <Setter variable="a" function="pe" priority="0" />
    <Setter variable="o0" function="(g/2)*pow(dt/(vc*cos(a)-vdtr),2) + (vc*sin(a)-vztr)*(dt/(vc*cos(a)-vdtr)) - zt" priority="0" />
    <Setter variable="o1" function="(pi/180)*((dt*vc*sin(a)*(vc*sin(a)-vztr))/pow(vc*cos(a)-vdtr,2) + (pow(dt,2)*g*vc*sin(a))/pow(vc*cos(a)-vdtr,3) + (dt*vc*cos(a))/(vc*cos(a)-vdtr))" priority="0" />
    <Setter variable="o2" function="pow(pi/180,2)*((3*g*pow(dt*vc*sin(a),2))/pow(vc*cos(a)-vdtr,4) + (2*dt*pow(vc*sin(a),2)*(vc*sin(a)-vztr))/pow(vc*cos(a)-vdtr,3) + (dt*vc*cos(a)*(vc*sin(a)-vztr))/pow(vc*cos(a)-vdtr,2) - (dt*vc*sin(a))/(vc*cos(a)-vdtr) + (2*dt*pow(vc,2)*cos(a)*sin(a))/pow(vc*cos(a)-vdtr,2) + (pow(dt,2)*g*vc*cos(a))/pow(vc*cos(a)-vdtr,3))" priority="0" />
    <Setter variable="a2" function="o2/2" priority="0" />
    <Setter variable="b2" function="o1-o2*a" priority="0" />
    <Setter variable="c2" function="o0-o1*a+(o2*pow(a,2))/2" priority="0" />
    <Setter variable="phi1" function="(-b2+sqrt(pow(b2,2) - 4*a2*c2))/(2*a2)" priority="0" />
    <Setter variable="vd" function="vc*cos(phi1)" priority="0" />
    <Setter variable="vz" function="vc*sin(phi1)" priority="0" />
    <Setter variable="t1" function="dt/(vd - vdtr)" priority="0" />
    <Setter variable="t2" function="(-vz+vztr+checkee*sqrt(pow(vz-vztr,2)+2*(g)*(zt)))/g" priority="0" />
    <Setter variable="tavg" function="t2" priority="0" />
    <Setter variable="xexp" function="TargetDistance*cos(TargetElevation)*sin(TargetHeading) + vxtr*tavg" priority="0" />
    <Setter variable="yexp" function="TargetDistance*cos(TargetElevation)*cos(TargetHeading) + vytr*tavg" priority="0" />
    <Setter variable="theta1" function="atan2(xexp,yexp)" priority="0" />
    <Setter variable="checkee" function="TargetElevation &gt; 0 ? 1 : -1" priority="0" />
    <Setter variable="fuse" function="Activate7 ? 10000000 : tavg" priority="0" />
  </Variables>
