  <Variables>
    <Setter variable="steering" function="clamp(Roll - (GS &gt; 1 &amp; abs(AngleOfSlip) &lt; 90 ? YawRate*0.01 : 0),-1,1)" priority="0" />
    <Setter variable="brakeLight" function="Brake &gt; 0" priority="0" />
    <Setter variable="gear" function="0" priority="0" activator="Time &lt; 0.05" />
    <Setter variable="gear" function="gear + (FireGuns ? (gearShift &gt; 0 ? clamp01(rate(gearShift)) : 0) : (gearShift &lt; 0 ? -clamp01(-rate(gearShift)) : 0))" priority="0" />
    <Setter variable="gear" function="-1" priority="0" activator="gear &lt; -1" />
    <Setter variable="gear" function="5" priority="0" activator="gear &gt; 5" />
    <Setter variable="engineInput" function="!FireGuns ? clamp01(gear = -1)*(clamp01((1+0.1)/(0.001*pow(engineRPM,2)+1)-0.1)*-clamp01(Pitch)) + clamp01(gear = 1)*(clamp01((1+0.1)/(0.001*pow(engineRPM,2)+1)-0.1)*clamp01(Pitch)) + clamp01(gear = 2)*(clamp01((0.9+0.1)/(0.0001*pow(engineRPM-150,2)+1)-0.1)*clamp01(Pitch)) + clamp01(gear = 3)*(clamp01((0.7+0.1)/(0.00008*pow(engineRPM-310,2)+1)-0.1)*clamp01(Pitch)) + clamp01(gear = 4)*(clamp01((0.6+0.1)/(0.00003*pow(engineRPM-510,2)+1)-0.1)*clamp01(Pitch)) + clamp01(gear = 5)*(clamp01((0.8+0.1)/(0.000005*pow(engineRPM-1500,2)+1)-0.1)*clamp01(Pitch)) : 0 " priority="0" />
    <Setter variable="gearShift" function="(rate(sum(Yaw)) &gt; 0 ? 1 : 0) - (rate(sum(Yaw)) &lt; 0 ? 1 : 0)" priority="0" />
    <Setter variable="counter" function="counter + clamp01(rate(gearShift))" priority="0" />
  </Variables>
