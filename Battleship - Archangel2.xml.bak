    <Setter variable="B3o2" function="pow(pi/180,2)*((3*g*pow(B3dt*vB*sin(B3a),2))/pow(vB*cos(B3a)-B3vdtr,4) + (2*B3dt*pow(vB*sin(B3a),2)*(vB*sin(B3a)-B3vztr))/pow(vB*cos(B3a)-B3vdtr,3) + (B3dt*vB*cos(B3a)*(vB*sin(B3a)-B3vztr))/pow(vB*cos(B3a)-B3vdtr,2) - (B3dt*vB*sin(B3a))/(vB*cos(B3a)-B3vdtr) + (2*B3dt*pow(vB,2)*cos(B3a)*sin(B3a))/pow(vB*cos(B3a)-B3vdtr,2) + (pow(B3dt,2)*g*vB*cos(B3a))/pow(vB*cos(B3a)-B3vdtr,3))" priority="0" />
    <Setter variable="B3a2" function="B3o2/2" priority="0" />
