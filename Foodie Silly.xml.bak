        <TextDecal.State penetration="0.5" position="1.3141,3.690664,-0.0581425" rotation="0,-0.7071068,0,0.7071068" decalRotation="(0.00, 0.00, 0.00)" size="4,0.9,0.1" color="A7AD00" opacity="1" priority="0" target="Multiple Parts" partIds="76,107,5,182,108,183,6,7,8,10,9,11" text="&lt;align=&quot;left&quot;&gt;&lt;size=1&gt;&lt;color=#FF0000&gt;&lt;pos=6.5%&gt;Entrees&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Touch-and-Go Tacos&lt;pos=19%&gt;$16.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Carnitas, diced white onion, queso&#xA;fresco and cilantro with salsa verde&#xA;and guacamole on corn tortillas&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Nosewheel Nachos&lt;pos=19%&gt;$17.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Tortilla chips with diced chicken,&#xA;queso, black beans, diced tomato,&#xA;sour cream and salsa&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Gigachad Burrito&lt;color=#FF0000&gt;*&lt;color=#A7AD00&gt;&lt;pos=19%&gt;$18.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Carne asada, cheese, fries, guacamole,&#xA;sour cream and pico de gallo wrapped&#xA;in a flour tortilla&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Empennage Empanadas&lt;pos=19%&gt;$15.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Ground beef, cheese and onions, served&#xA;with queso dipping sauce&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.3&gt;&lt;color=#FF0000&gt;&lt;pos=8%&gt;* Chad's favorite&#xA;&lt;line-height=-8.2&gt;&#xA;&lt;/line-height&gt;&lt;size=1&gt;&lt;color=#FF0000&gt;&lt;pos=84%&gt;Sides&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;&lt;pos=76.5%&gt;Final Approach Fries&lt;pos=95%&gt;$4.99&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;&lt;pos=76.5%&gt;Chad's Chips&lt;color=#FF0000&gt;*&lt;color=#A7AD00&gt;&lt;pos=95%&gt;$4.49&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;&lt;pos=76.5%&gt;With salsa. $1.29 for guac&#xA;&lt;size=0.1&gt;&#xA;&lt;size=1&gt;&lt;color=#FF0000&gt;&lt;pos=83%&gt;Drinks&lt;align=&quot;left&quot;&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;&lt;pos=76.5%&gt;Hypersonic Horchata&lt;color=#FF0000&gt;*&lt;color=#A7AD00&gt;&lt;pos=95%&gt;$2.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;&lt;pos=76.5%&gt;Rice-based horchata flavored with&#xA;&lt;pos=76.5%&gt;cinnamon and vanilla&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;&lt;pos=76.5%&gt;Fixed-wing Fresca&lt;pos=95%&gt;$2.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;&lt;pos=76.5%&gt;Pineapple mango agua fresca with&#xA;&lt;pos=76.5%&gt;a hint of lime on crushed ice&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;&lt;pos=76.5%&gt;Wingtip Water&lt;pos=95%&gt;$1.49&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;&lt;pos=76.5%&gt;...it's just water&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.3&gt;&lt;color=#FF0000&gt;&lt;pos=84%&gt;* Chad's favorite" font="Stencil" fontSize="1" alignV="Top" alignH="Center" />
