    <Setter variable="B4o0" function="(g/2)*pow(B4dt/(vB*cos(B4a)-B4vdtr),2) + (vB*sin(B4a)-B4vztr)*(B4dt/(vB*cos(B4a)-B4vdtr)) - B4zt" priority="0" />
    <Setter variable="B4o1" function="(pi/180)*((B4dt*vB*sin(B4a)*(vB*sin(B4a)-B4vztr))/pow(vB*cos(B4a)-B4vdtr,2) + (pow(B4dt,2)*g*vB*sin(B4a))/pow(vB*cos(B4a)-B4vdtr,3) + (B4dt*vB*cos(B4a))/(vB*cos(B4a)-B4vdtr))" priority="0" />
    <Setter variable="B4o2" function="pow(pi/180,2)*((3*g*pow(B4dt*vB*sin(B4a),2))/pow(vB*cos(B4a)-B4vdtr,4) + (2*B4dt*pow(vB*sin(B4a),2)*(vB*sin(B4a)-B4vztr))/pow(vB*cos(B4a)-B4vdtr,3) + (B4dt*vB*cos(B4a)*(vB*sin(B4a)-B4vztr))/pow(vB*cos(B4a)-B4vdtr,2) - (B4dt*vB*sin(B4a))/(vB*cos(B4a)-B4vdtr) + (2*B4dt*pow(vB,2)*cos(B4a)*sin(B4a))/pow(vB*cos(B4a)-B4vdtr,2) + (pow(B4dt,2)*g*vB*cos(B4a))/pow(vB*cos(B4a)-B4vdtr,3))" priority="0" />
