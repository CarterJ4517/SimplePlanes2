      <Part id="129" partType="TextDecal-1" position="1.2641,3.755664,-1.58158" rotation="270,270,0" drag="0,0,0,0,0,0" dragArea="0,0,0,0,0,0" materials="0,1,2,3" symmetryDisabled="true" partCollisionResponse="Default">
        <TextDecal.State penetration="0.5" position="1.3141,3.755664,-1.58158" rotation="0,-0.7071068,0,0.7071068" decalRotation="(0.00, 0.00, 0.00)" size="0.9,0.9,0.1" color="A7AD00" opacity="1" priority="0" target="Multiple Parts" partIds="7,8,9,10" text="&lt;size=1&gt;&lt;color=#FF0000&gt;Entrees&lt;align=&quot;left&quot;&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Touch-and-Go Tacos&lt;pos=80%&gt;$16.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Carnitas, diced white onion, queso&#xA;fresco and cilantro with salsa verde&#xA;and guacamole on corn tortillas&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Nosewheel Nachos&lt;pos=80%&gt;$17.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Tortilla chips with diced chicken,&#xA;queso, black beans, diced tomato,&#xA;sour cream and salsa&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Gigachad Burrito&lt;color=#FF0000&gt;*&lt;color=#A7AD00&gt;&lt;pos=80%&gt;$18.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Carne asada, cheese, fries, guacamole,&#xA;sour cream and pico de gallo wrapped&#xA;in a flour tortilla&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.5&gt;&lt;color=#A7AD00&gt;Empennage Empanadas&lt;pos=80%&gt;$15.99&#xA;&lt;size=0.3&gt;&lt;color=#F0F0F0&gt;Ground beef, cheese and onions, served&#xA;with queso dipping sauce&#xA;&lt;size=0.1&gt;&#xA;&lt;size=0.3&gt;&lt;align=&quot;center&quot;&gt;&lt;color=#FF0000&gt;* Chad's favorite" font="Stencil" fontSize="1" alignV="Top" alignH="Center" />
